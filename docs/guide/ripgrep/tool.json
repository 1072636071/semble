  "features": [
    "极速递归搜索，性能优于传统 grep",
    "自动尊重 .gitignore 并跳过隐藏/二进制文件",
    "完整 Unicode 与正则表达式支持",
    "可作为库嵌入其它 Rust 项目"
  ],
  "install": [
    {
      "title": "使用 cargo 安装",
      "lang": "bash",
      "code": "cargo install ripgrep"
    },
    {
      "title": "使用包管理器安装（macOS）",
      "lang": "bash",
      "code": "brew install ripgrep"
    }
  ],
  "usage": [
    {
      "title": "搜索目录中包含某关键词的行",
      "lang": "bash",
      "code": "rg \"TODO\" src/"
    },
    {
      "title": "仅显示匹配的文件名",
      "lang": "bash",
      "code": "rg -l \"fn main\""
    },
    {
      "title": "使用正则并忽略大小写",
      "lang": "bash",
      "code": "rg -i --regexp \"error|warn\""
    }
  ]
